{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jamaisvu-api",
  "main": "src/index.js",
  "compatibility_date": "2026-08-26",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jamaisvu",
      "migrations_dir": "migrations"
    },
    {
      "binding": "MEDIA",
      "database_name": "jamaisvu-media",
      "migrations_dir": "media-migrations"
    }
  ]
}
