<?xml version="1.0" encoding="utf-8"?>
<!-- The illustrated lamppost mark (docs/lamplight_icon.png) centered on a dark gray
     background, replacing the flat "Four Panes" vector as the launcher icon. Four Panes
     itself is unretired: it's still the in-app Home Lantern indicator (ui/Lantern.kt). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#3A3A3A" />
        </shape>
    </item>
    <item
        android:width="50dp"
        android:height="80dp"
        android:gravity="center">
        <bitmap
            android:src="@drawable/lamplight_mark_icon"
            android:gravity="fill" />
    </item>
</layer-list>
